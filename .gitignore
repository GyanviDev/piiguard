target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

### Runtime data ###
# The H2 audit database. It contains redacted prompts and request metadata — no raw PII by
# design, but it is still operational data and has no business in version control.
data/
*.db
*.mv.db
*.trace.db

### Secrets ###
# Nothing here should ever be committed. Configuration reads from the environment.
.env
.env.*
!.env.example
*.pem
*.key

### Python service ###
# Model artefacts are BUILD OUTPUT — trained during the Docker build from train_model.py, so
# the image is self-contained and the served model provably matches the evaluated one.
# Committing a .pkl invites a stale binary that nobody can reproduce or review.
*.pkl
model_metadata.json
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

### IDE ###
.idea
*.iws
*.iml
*.ipr
.classpath
.project
.settings
.factorypath
.apt_generated
.springBeans
.sts4-cache
.vscode/

